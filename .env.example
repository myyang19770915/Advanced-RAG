# ============================================================
# Advanced RAG — Docker Compose 環境設定範本
# 複製此檔為 .env 並填入實際值
# cp .env.example .env
# ============================================================

# ── LLM ────────────────────────────────────────────────────
# 使用 LM Studio / Ollama / OpenAI Compatible API
LLM_PROVIDER=openai
LLM_BASE_URL=http://192.168.x.x:1234/v1    # 改為你的 LLM 服務 IP
LLM_API_KEY=lm-studio                       # LM Studio 任意填；OpenAI 填 sk-...
LLM_MODEL=qwen35-27b

# ── Embedding ───────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://192.168.x.x:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIM=1024

# ── VLM (PDF 圖片描述，可設 off 停用) ──────────────────────
VLM_PROVIDER=openai
VLM_BASE_URL=http://192.168.x.x:1234/v1
VLM_API_KEY=lm-studio
VLM_MODEL=qwen35-27b
VLM_MAX_IMAGE_SIDE=1024

# ── Docling (PDF 解析引擎) ─────────────────────────────────
# local = 使用本機 Docling SDK（已內建於 image）
# mock  = 跳過解析（測試用）
DOCLING_PROVIDER=local

# ── Hybrid Search ───────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
SPARSE_PROVIDER=bm25       # bm25 | off
RETRIEVE_TOP_K=30
FINAL_TOP_N=5

# ── Reranker ────────────────────────────────────────────────
# Cohere API: https://dashboard.cohere.com/api-keys
RERANK_ENABLED=true
RERANK_PROVIDER=cohere_compat
RERANK_BASE_URL=https://api.cohere.com/v1
RERANK_API_KEY=YOUR_COHERE_API_KEY_HERE
RERANK_MODEL=rerank-v4.0-fast
RERANK_TIMEOUT_S=30

# ── Security ────────────────────────────────────────────────
ADMIN_TOKEN=change-me-in-production
