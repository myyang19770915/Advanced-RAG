APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Vector store
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM (LM Studio)
LLM_PROVIDER=openai
LLM_BASE_URL=http://192.168.68.111:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen35-27b

# Embedding (LM Studio, dim=1024)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://192.168.68.111:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIM=1024

# Docling (local SDK)
DOCLING_PROVIDER=local
DOCLING_HTTP_URL=

DATA_DIR=./data
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
